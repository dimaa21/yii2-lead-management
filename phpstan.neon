parameters:
    level: 5

    paths:
        - assets
        - commands
        - components
        - controllers
        - mail
        - models
        - services
        - widgets
        - tests/Acceptance
        - tests/Functional
        - tests/Unit

    scanDirectories:
        - tests/Support

    bootstrapFiles:
        - tests/_bootstrap.php

    dynamicConstantNames:
        - YII_DEBUG
        - YII_ENV
        - YII_ENV_DEV
        - YII_ENV_PROD
        - YII_ENV_TEST

    tmpDir: %currentWorkingDirectory%/runtime
